# HAVEN AI Environment Variables
# Copy this file to .env and populate your keys. Never commit real API keys.

# Google Gemini API Key for HAVEN AI voice and text intelligence
GEMINI_API_KEY=

# Resend API Key for sending confirmed project enquiries (e.g. re_xxxx)
RESEND_API_KEY=

# Recipient email address for verified HAVEN AI project enquiries
HAVEN_OWNER_EMAIL=hello.havenweb@gmail.com

# Server Port (default 3000)
PORT=3000

# Allowed CORS Origin for production (e.g. https://your-haven-domain.com or *)
ALLOWED_ORIGIN=*
